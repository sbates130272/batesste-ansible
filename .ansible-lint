---
# .ansible-lint
# See https://ansible-lint.readthedocs.io/configuring/

exclude_paths:
  - .github
  - changelogs
  - tests/sanity

# playbooks/hosts.yml is a static inventory (passed via `-i`), not a
# playbook, but its location doesn't match the default `**/inventory/**`
# kind-detection glob, so ansible-lint would otherwise try to parse it as
# a list of plays and fail with a fatal syntax-check error.
kinds:
  - inventory: "playbooks/hosts.yml"

warn_list:
  - command-instead-of-module
  - command-instead-of-shell
  - name[template]
  - schema[meta]  # Ubuntu resolute not yet in schema
  - var-naming[no-role-prefix]

extra_vars:
  targets: localhost
