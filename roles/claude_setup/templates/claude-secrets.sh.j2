# Claude CLI secrets - do not share or commit this file
{% if claude_setup_api_key | length > 0 %}
export ANTHROPIC_API_KEY={{ claude_setup_api_key }}
{% endif %}
{% if claude_setup_apim_key | length > 0 %}
export ANTHROPIC_CUSTOM_HEADERS="Ocp-Apim-Subscription-Key: {{ claude_setup_apim_key }}"
export AMD_LLM_GATEWAY_KEY={{ claude_setup_apim_key }}
{% endif %}
{% if claude_setup_apim_key | length > 0 and claude_setup_usage_api_url | length > 0 %}
claude-usage() {
  local start="${1:-$(date +%Y-%m-01)}"
  local end="${2:-$(date +%Y-%m-%d)}"
  curl -s "{{ claude_setup_usage_api_url }}?start=${start}&end=${end}" \
    -H "Ocp-Apim-Subscription-Key: ${AMD_LLM_GATEWAY_KEY}" | jq
}
{% endif %}
